# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production (FLASK_ENV=production): the app refuses to start without it.
JWT_SECRET_KEY=your-secret-key-here

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev only): sqlite:///ordo.db  (no enum enforcement — use PostgreSQL for anything real)
# PostgreSQL (prod): postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/ordo

# ── Email (Flask-Mail) ────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@example.com

# ── Frontend ──────────────────────────────────────────────────────────────────
# Used for constructing password-reset links in emails
FRONTEND_URL=http://localhost:5173

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=another-secret-key-for-sessions

# ── Observability ─────────────────────────────────────────────────────────────
# Leave blank to disable Sentry error tracking
SENTRY_DSN=

# ── Redis (optional) ─────────────────────────────────────────────────────────
# When set, used for rate-limiter storage + Socket.IO multi-worker adapter
# Format: redis://user:password@host:6379/0
REDIS_URL=

# ── Deployment ───────────────────────────────────────────────────────────────
# Reverse proxies in front of the app (Render, nginx, …). Needed for correct per-client
# rate limiting. Defaults to 1 in production and 0 otherwise.
# TRUSTED_PROXY_COUNT=1
# Set to 0 on all but ONE instance when running several (the scheduler sends reminders
# and creates recurring tasks). Jobs are safe if two run at once, but that wastes work.
# RUN_SCHEDULER=1
